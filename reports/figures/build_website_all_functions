// Dependency Graph
digraph {
	graph [compound=true concentrate=true rankdir=LR ranksep=0.4 style=filled]
	node [fillcolor="#ffffff"]
	save_edges_bins [label=<<b>save_edges_bins</b><br /><br /><i>save_edges_bins()</i>> fillcolor="#b4d8e4" fontname=Helvetica margin=0.15 shape=cylinder style="rounded,filled"]
	edges [label=<<b>edges</b><br /><br /><i>list</i>> fillcolor="#b4d8e4" fontname=Helvetica margin=0.15 shape=rectangle style="rounded,filled"]
	topic_metrics [label=<<b>topic_metrics</b><br /><br /><i>dict</i>> fillcolor="#b4d8e4" fontname=Helvetica margin=0.15 shape=rectangle style="rounded,filled"]
	raw_nodes [label=<<b>raw_nodes</b><br /><br /><i>list</i>> fillcolor="#b4d8e4" fontname=Helvetica margin=0.15 shape=rectangle style="rounded,filled"]
	clusters_legend [label=<<b>clusters_legend</b><br /><br /><i>dict</i>> fillcolor="#b4d8e4" fontname=Helvetica margin=0.15 shape=rectangle style="rounded,filled"]
	assembled_website [label=<<b>assembled_website</b><br /><br /><i>dict</i>> fillcolor="#b4d8e4" fontname=Helvetica margin=0.15 shape=rectangle style="rounded,filled"]
	parsed_graphml [label=<<b>parsed_graphml</b><br /><br /><i>tuple</i>> fillcolor="#b4d8e4" fontname=Helvetica margin=0.15 shape=rectangle style="rounded,filled"]
	node_records [label=<<b>node_records</b><br /><br /><i>list</i>> fillcolor="#b4d8e4" fontname=Helvetica margin=0.15 shape=rectangle style="rounded,filled"]
	save_clusters_json [label=<<b>save_clusters_json</b><br /><br /><i>save_clusters_json()</i>> fillcolor="#b4d8e4" fontname=Helvetica margin=0.15 shape=cylinder style="rounded,filled"]
	communities_legend [label=<<b>communities_legend</b><br /><br /><i>dict</i>> fillcolor="#b4d8e4" fontname=Helvetica margin=0.15 shape=rectangle style="rounded,filled"]
	save_nodes_json [label=<<b>save_nodes_json</b><br /><br /><i>save_nodes_json()</i>> fillcolor="#b4d8e4" fontname=Helvetica margin=0.15 shape=cylinder style="rounded,filled"]
	save_communities_json [label=<<b>save_communities_json</b><br /><br /><i>save_communities_json()</i>> fillcolor="#b4d8e4" fontname=Helvetica margin=0.15 shape=cylinder style="rounded,filled"]
	save_abstracts_json [label=<<b>save_abstracts_json</b><br /><br /><i>save_abstracts_json()</i>> fillcolor="#b4d8e4" fontname=Helvetica margin=0.15 shape=cylinder style="rounded,filled"]
	abstracts [label=<<b>abstracts</b><br /><br /><i>dict</i>> fillcolor="#b4d8e4" fontname=Helvetica margin=0.15 shape=rectangle style="rounded,filled"]
	node_records -> save_edges_bins
	edges -> save_edges_bins
	parsed_graphml -> edges
	_topic_metrics_inputs [label=<<table border="0"><tr><td>topic_metrics_path</td><td>Path</td></tr></table>> fontname=Helvetica margin=0.15 shape=rectangle style="filled,dashed"]
	_topic_metrics_inputs -> topic_metrics
	parsed_graphml -> raw_nodes
	node_records -> clusters_legend
	topic_metrics -> clusters_legend
	save_nodes_json -> assembled_website
	save_clusters_json -> assembled_website
	save_communities_json -> assembled_website
	save_abstracts_json -> assembled_website
	save_edges_bins -> assembled_website
	_parsed_graphml_inputs [label=<<table border="0"><tr><td>graphml_path</td><td>Path</td></tr></table>> fontname=Helvetica margin=0.15 shape=rectangle style="filled,dashed"]
	_parsed_graphml_inputs -> parsed_graphml
	raw_nodes -> node_records
	clusters_legend -> save_clusters_json
	node_records -> communities_legend
	node_records -> save_nodes_json
	communities_legend -> save_communities_json
	abstracts -> save_abstracts_json
	raw_nodes -> abstracts
	subgraph cluster__legend {
		graph [fillcolor="#ffffff" fontname=helvetica label=Legend rank=same]
		input [fontname=Helvetica margin=0.15 shape=rectangle style="filled,dashed"]
		function [fillcolor="#b4d8e4" fontname=Helvetica margin=0.15 shape=rectangle style="rounded,filled"]
		materializer [fontname=Helvetica margin="0.15,0.1" shape=cylinder style=filled]
	}
}
